# Backend environment configuration
# Copy this file to .env and set the values for your environment.

# Firebase project ID (required for backend Firebase Admin SDK)
FIREBASE_PROJECT_ID=

# Path to Firebase service account JSON file (required for backend Firebase Admin SDK)
# Use absolute path or relative to backend/ directory.
# Example: FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-credentials.json
FIREBASE_SERVICE_ACCOUNT_PATH=

# CORS allowed origins (comma-separated)
# Development: http://localhost:5173
# Production: https://your-frontend-domain.com
CORS_ORIGINS=http://localhost:5173